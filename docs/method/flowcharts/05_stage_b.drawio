<mxfile host="65bd71144e">
    <diagram id="page-1" name="1. Contract">
        <mxGraphModel dx="1220" dy="630" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1080" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Stage B — relational target segmenter" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1A365D;fontFamily=Helvetica" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="980" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="src/models.py: StageB  ·  src/engine.py: StageBTask  ·  13,710,913 parameters&lt;br&gt;Three ordered anchor masks, three clause tokens and one anonymous occupancy map in. The target mask out. The target is never an input — inferring it is the task." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#4A5568;fontFamily=Helvetica" parent="1" vertex="1">
                    <mxGeometry x="40" y="62" width="1600" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Prompt&lt;/b&gt; (never pooled into one vector)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;segment the structure that is &lt;b&gt;superior to the cube&lt;/b&gt;, &lt;b&gt;medial to the torus&lt;/b&gt;, and &lt;b&gt;anterior to the sphere&lt;/b&gt;.&lt;/font&gt;&lt;br&gt;&lt;br&gt;No single relation identifies anything — “superior to the cube” is a half-volume. Only the &lt;b&gt;intersection of all three&lt;/b&gt; picks out one region. A model that pools the sentence before grounding cannot express that conjunction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontSize=12;fontFamily=Helvetica;align=left;spacing=12;verticalAlign=middle;arcSize=8;fontStyle=2" parent="1" vertex="1">
                    <mxGeometry x="40" y="120" width="1600" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="What StageB.forward actually receives" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="270" width="500" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="&lt;b&gt;anchors&lt;/b&gt;&lt;br&gt;[B, 3, 64, 64, 64]&lt;br&gt;ordered binary mask channels&lt;br&gt;the WHERE signal — the only geometry the prompt refers to" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="318" width="460" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="&lt;b&gt;direction_ids&lt;/b&gt;  +  &lt;b&gt;name_ids&lt;/b&gt;&lt;br&gt;[B, 3]  +  [B, 3]&lt;br&gt;six directions {L,R,A,P,S,I} and the named anchor’s vocab index, one pair per clause, never the target’s name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="418" width="460" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="&lt;b&gt;occupancy&lt;/b&gt;&lt;br&gt;[B, 1, 64, 64, 64]&lt;br&gt;anonymous “something is here” map — decoder only, never the encoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="518" width="460" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="A relation always describes the &lt;b&gt;target relative to the anchor&lt;/b&gt;. Channel i is locked to clause i unless a counterfactual breaks that link." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="618" width="460" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="Where each stream is allowed to go" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="560" y="270" width="540" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="&lt;b&gt;Encoder&lt;/b&gt;  ←  anchors + world (x,y,z)&lt;br&gt;leaky ReLU, coords on every scale&lt;br&gt;64³/32 → 32³/64 → 16³/128 → 8³/256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontFamily=Helvetica;arcSize=8;verticalAlign=middle" parent="1" vertex="1">
                    <mxGeometry x="580" y="318" width="500" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="&lt;b&gt;RelationPrompt + StructureEncoder&lt;/b&gt;&lt;br&gt;R_i and S_i stay unpooled. Correspondence is only learnable if clauses stay separate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="580" y="402" width="500" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="&lt;b&gt;Evidence&lt;/b&gt; (one shared module × 3 slots)&lt;br&gt;the only spatial attention — at the 8³ bottleneck (512 tokens), not at 64³" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontFamily=Helvetica;arcSize=8;verticalAlign=middle" parent="1" vertex="1">
                    <mxGeometry x="580" y="478" width="500" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="&lt;b&gt;Intersection&lt;/b&gt;  [H₁, H₂, H₃, σ(H₁)·σ(H₂)·σ(H₃)]&lt;br&gt;the product is high only where &lt;b&gt;every&lt;/b&gt; relation holds at once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontFamily=Helvetica;arcSize=8;verticalAlign=middle" parent="1" vertex="1">
                    <mxGeometry x="580" y="554" width="500" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="15" value="&lt;b&gt;Decoder&lt;/b&gt;  ←  occupancy (after anchors subtracted) + FiLM(C)&lt;br&gt;occupancy sharpens a region already chosen. It must not decide &lt;i&gt;where&lt;/i&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="580" y="630" width="500" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="Never an input to the network" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="1120" y="270" width="520" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="17" value="label volume  &lt;font color='#C53030'&gt;&lt;b&gt;labels&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontFamily=Helvetica;arcSize=6;dashed=1;dashPattern=8 6" parent="1" vertex="1">
                    <mxGeometry x="1140" y="318" width="480" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="18" value="target mask  &lt;font color='#C53030'&gt;&lt;b&gt;labels == target&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontFamily=Helvetica;arcSize=6;dashed=1;dashPattern=8 6" parent="1" vertex="1">
                    <mxGeometry x="1140" y="374" width="480" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="19" value="target name  &lt;font color='#C53030'&gt;&lt;b&gt;target_name&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontFamily=Helvetica;arcSize=6;dashed=1;dashPattern=8 6" parent="1" vertex="1">
                    <mxGeometry x="1140" y="430" width="480" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="20" value="target centroid / position" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontFamily=Helvetica;arcSize=6;dashed=1;dashPattern=8 6" parent="1" vertex="1">
                    <mxGeometry x="1140" y="486" width="480" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="21" value="These are the answer. They are used only &lt;b&gt;after&lt;/b&gt; the forward to build the supervision mask for Dice + BCE. If any of them reached the encoder or the occupancy in a way that marks the finding, the model could ignore the prompt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="1140" y="546" width="480" height="136" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="Output" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="720" width="800" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="23" value="&lt;b&gt;logits&lt;/b&gt;  [B, 1, 64, 64, 64]&lt;br&gt;1×1 conv, zero-init weight, bias = logit(0.0016)&lt;br&gt;sigmoid → predicted target mask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C6F6D5;strokeColor=#38A169;fontSize=12;fontFamily=Helvetica;fontStyle=1;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="60" y="768" width="760" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="24" value="Loss lives in StageBTask, not in StageB:  λ_dice · soft Dice + λ_bce · BCEWithLogits  (float32)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="860" width="760" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="25" value="Config that chooses the input &lt;i&gt;source&lt;/i&gt; and occupancy &lt;i&gt;mode&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="860" y="720" width="780" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="26" value="&lt;b&gt;train.stage_b.mode&lt;/b&gt;   predicted (default) | oracle&lt;br&gt;predicted requires a Stage A checkpoint; one forward produces both streams.&lt;br&gt;oracle is the only bypass: ground-truth masks for both. They cannot be mixed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="880" y="768" width="740" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="27" value="&lt;b&gt;train.stage_b.occupancy_mode&lt;/b&gt;   all | anchors-only (default) | none&lt;br&gt;&lt;b&gt;all&lt;/b&gt; is the ceiling (target included if the source can name it). anchors-only / none do not leak the finding." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="880" y="848" width="740" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="28" value="&lt;b&gt;Colour&lt;/b&gt;   &lt;font color='#2B6CB0'&gt;■ volumes / masks&lt;/font&gt;   &lt;font color='#2F855A'&gt;■ tokens&lt;/font&gt;   &lt;font color='#C05621'&gt;■ occupancy&lt;/font&gt;   &lt;font color='#6B46C1'&gt;■ modules&lt;/font&gt;   &lt;font color='#C53030'&gt;■ forbidden&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#4A5568" parent="1" vertex="1">
                    <mxGeometry x="40" y="940" width="1600" height="28" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page-2" name="2. Building the inputs">
        <mxGraphModel dx="1220" dy="630" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1240" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="From a batch to StageB.forward — StageBTask.__call__" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1A365D;fontFamily=Helvetica" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1200" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="The network never sees the raw batch. StageBTask turns it into four tensors, then StageB.forward subtracts the anchors from occupancy before anything else." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#4A5568;fontFamily=Helvetica" parent="1" vertex="1">
                    <mxGeometry x="40" y="62" width="1680" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="Batch  (what the dataset returns)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="110" width="400" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="&lt;b&gt;image&lt;/b&gt;&lt;br&gt;[B, 1, 64, 64, 64]&lt;br&gt;intensity — used only if Stage A is the source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="158" width="360" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="&lt;b&gt;labels&lt;/b&gt;&lt;br&gt;[B, 64, 64, 64]&lt;br&gt;int volume, 0 = background, id = vocab + 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="238" width="360" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="&lt;b&gt;anchors&lt;/b&gt;&lt;br&gt;[B, 3]  label ids of the three named structures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="318" width="360" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="&lt;b&gt;direction_ids&lt;/b&gt;&lt;br&gt;[B, 3]  0..5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="384" width="360" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="&lt;b&gt;name_ids&lt;/b&gt;  (default: anchors − 1)&lt;br&gt;[B, 3]  vocab indices; a counterfactual can break this lock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="442" width="360" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="&lt;b&gt;target&lt;/b&gt;&lt;br&gt;[B]  label id — supervision only, never forwarded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontFamily=Helvetica;arcSize=6;dashed=1;dashPattern=8 6" parent="1" vertex="1">
                    <mxGeometry x="60" y="522" width="360" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="Also carried: target_name, anchor_names, directions, example_id — metrics, not tensors." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="588" width="360" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="Source  (one switch for both streams)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="460" y="110" width="440" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="&lt;b&gt;train.stage_b.mode&lt;/b&gt;&lt;br&gt;predicted (default)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Helvetica" parent="1" vertex="1">
                    <mxGeometry x="565" y="178" width="230" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="&lt;b&gt;oracle → ground truth&lt;/b&gt;&lt;br&gt;anchors = (labels == anchor_ids)&lt;br&gt;occupancy from labels, never Stage A. Checkpoint not required." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="480" y="360" width="400" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="15" value="&lt;b&gt;predicted → Stage A&lt;/b&gt;&lt;br&gt;one forward produces both the encoder anchors and the occupancy union.&lt;br&gt;Requires phase_a_checkpoint. Labels are not read as inputs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontFamily=Helvetica;arcSize=8;verticalAlign=middle" parent="1" vertex="1">
                    <mxGeometry x="480" y="468" width="400" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="oracle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="13" target="14" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="17" value="predicted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="13" target="15" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="545" y="228"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="18" value="Same source must produce both the encoder’s anchor channels and the occupancy. That is the leak-fix: predicted anchors + GT occupancy is forbidden." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="480" y="580" width="400" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="19" value="Occupancy mode  (independent of source)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="920" y="110" width="400" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="20" value="&lt;b&gt;all&lt;/b&gt;&lt;br&gt;union of every shape the source can name.&lt;br&gt;Ceiling, not the default: GT includes the target’s voxels; a segmenter trained on that name will paint it too." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="940" y="158" width="360" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="21" value="&lt;b&gt;anchors-only&lt;/b&gt;  (default)&lt;br&gt;union of the three prompt anchors (the same tensor the encoder will see)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="940" y="274" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="&lt;b&gt;none&lt;/b&gt;&lt;br&gt;zeros. Stage B has to localise from the relations alone." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="940" y="370" width="360" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="23" value="After StageB.forward subtracts the anchors, &lt;b&gt;anchors-only is empty at the decoder&lt;/b&gt; — same as none there. Different at occupancy_from’s return, identical after the subtract." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="940" y="458" width="360" height="108" as="geometry"/>
                </mxCell>
                <mxCell id="24" value="Handed to the network" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="1340" y="110" width="380" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="25" value="&lt;b&gt;anchors&lt;/b&gt;&lt;br&gt;[B, 3, 64, 64, 64]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="1360" y="200" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="29" value="&lt;b&gt;StageB.forward(&lt;/b&gt;&lt;br&gt;anchors, direction_ids,&lt;br&gt;name_ids, occupancy&lt;b&gt;)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontFamily=Helvetica;arcSize=8;verticalAlign=middle" parent="1" vertex="1">
                    <mxGeometry x="1360" y="480" width="340" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="30" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;startArrow=none;" parent="1" source="27" target="29" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;startArrow=none;" parent="1" source="28" target="29" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="33" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="28" target="29" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="34" value="First line of StageB.forward — architectural invariant" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="650" width="1680" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="35" value="&lt;b&gt;occupancy = occupancy × (1 − anchors.amax(dim=1))&lt;/b&gt;&lt;br&gt;&lt;br&gt;The anchors are the given, not the answer. Leaving them in occupancy would hand the decoder a free copy of the conditioning it is supposed to reason about. What remains is one binary channel in which the target is an unmarked structure among others — it says “something is here”, never “this one”." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="698" width="1020" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="36" value="&lt;b&gt;Why occupancy never reaches the encoder&lt;/b&gt;&lt;br&gt;&lt;br&gt;If grounding queries could see the target’s own voxels, the model could ignore the prompt and pick “the blob that is not an anchor”. On this corpus that heuristic often works. Keeping occupancy on the decoder means &lt;i&gt;where&lt;/i&gt; is decided from the relations; occupancy only sharpens the boundary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="1100" y="698" width="600" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="37" value="After the forward — supervision, not an input" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="870" width="1680" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="38" value="&lt;b&gt;target mask&lt;/b&gt; = (labels == target) → [B, 1, 64, 64, 64]&lt;br&gt;Built on the accelerator from the same label volume. Used only for the loss and metrics." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontFamily=Helvetica;arcSize=6;dashed=1;dashPattern=8 6" parent="1" vertex="1">
                    <mxGeometry x="60" y="918" width="700" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="39" value="&lt;b&gt;loss&lt;/b&gt; = Dice + BCEWithLogits against that mask&lt;br&gt;Always in float32: the Dice sum is 262,144 voxels at 64³; float16 cannot hold it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C6F6D5;strokeColor=#38A169;fontSize=12;fontFamily=Helvetica;fontStyle=1;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="780" y="918" width="500" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="40" value="&lt;b&gt;strata&lt;/b&gt; recorded per sample: target, anchor, direction, slot — so one eval pass reports every breakdown." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="1300" y="918" width="400" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="41" value="In predicted mode, each Stage A anchor is also scored with Dice against the oracle mask and reported as &lt;b&gt;anchor_dice&lt;/b&gt;, so a drop on the target can be attributed to segmentation error rather than the relational model." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="1008" width="1640" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="N3UzWc2qZDFcHcJtfBpX-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" edge="1" parent="1" source="25" target="26">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1530" y="256" as="sourcePoint"/>
                        <mxPoint x="1530" y="480" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="26" value="&lt;b&gt;direction_ids&lt;/b&gt;&lt;br&gt;[B, 3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="1360" y="274" width="340" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="N3UzWc2qZDFcHcJtfBpX-43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;startArrow=none;" edge="1" parent="1" source="26" target="27">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1530" y="322" as="sourcePoint"/>
                        <mxPoint x="1530" y="480" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="27" value="&lt;b&gt;name_ids&lt;/b&gt;&lt;br&gt;[B, 3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="1360" y="336" width="340" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="N3UzWc2qZDFcHcJtfBpX-44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" edge="1" parent="1" source="27" target="28">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1530" y="384.0000000000001" as="sourcePoint"/>
                        <mxPoint x="1530" y="480" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="28" value="&lt;b&gt;occupancy&lt;/b&gt;&lt;br&gt;[B, 1, 64, 64, 64]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="1360" y="402" width="340" height="56" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page-3" name="3. Forward architecture">
        <mxGraphModel dx="1220" dy="630" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1380" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="StageB.forward — tensors, modules, and why each hop exists" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1A365D;fontFamily=Helvetica" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1400" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="Default sizing at 64³: encoder_channels [32, 64, 128, 256], bottleneck 8³ = 512 tokens, token_dim 256, 4 heads, n_anchors = 3, leaky ReLU (0.01). World (x,y,z) in [−1, 1] concatenated at every scale." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#4A5568;fontFamily=Helvetica" parent="1" vertex="1">
                    <mxGeometry x="40" y="56" width="1800" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="&lt;b&gt;anchors&lt;/b&gt;&lt;br&gt;[B, 3, 64³]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="160" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="&lt;b&gt;direction_ids&lt;/b&gt;&lt;br&gt;[B, 3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="220" y="100" width="150" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="&lt;b&gt;name_ids&lt;/b&gt;&lt;br&gt;[B, 3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="390" y="100" width="140" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="&lt;b&gt;occupancy&lt;/b&gt;&lt;br&gt;[B, 1, 64³]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="1680" y="100" width="160" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="Encoder  (anchors only + xyz)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="180" width="280" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="F₀  64³ × 32&lt;br&gt;stem, stride 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9D8FD;strokeColor=#6B46C1;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="228" width="240" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="F₁  32³ × 64&lt;br&gt;stride 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9D8FD;strokeColor=#6B46C1;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="300" width="240" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="F₂  16³ × 128&lt;br&gt;stride 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9D8FD;strokeColor=#6B46C1;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="372" width="240" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="F₃  8³ × 256&lt;br&gt;stride 2  ·  bottleneck" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9D8FD;strokeColor=#6B46C1;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="444" width="240" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="Each stage: ConvBlock + ResBlock.&lt;br&gt;xyz concatenated before every stage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="524" width="240" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="4" target="9" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="9" target="10" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="10" target="11" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="11" target="12" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="18" value="Tokens stay unpooled — one per clause" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="340" y="180" width="520" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="19" value="&lt;b&gt;RelationPrompt&lt;/b&gt;  →  R [B, 3, 256]&lt;br&gt;R_i = LN( dir_i + name_i + pair(dir_i, name_i) + slot_i )&lt;br&gt;The pair table is why “lateral to the thalamus” need not equal lateral + thalamus." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="360" y="228" width="480" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="20" value="&lt;b&gt;StructureEncoder&lt;/b&gt;  →  S [B, 3, 256]&lt;br&gt;S_i = LN( visual(masked_pool(F₃, mask_i)) + geom(mask_i) + name_i + slot_i )&lt;br&gt;Geometry is measured from the mask itself — GT and predicted anchors are the same interface." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="360" y="328" width="480" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="5" target="19" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="6" target="19" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="12" target="20" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="4" target="20" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="6" target="20" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="26" value="Evidence  — one shared module, applied three times" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="340" y="450" width="520" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="27" value="&lt;b&gt;for slot i in {0,1,2}:&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;Fuse&lt;/b&gt;  C_i = LN( attn(R_i → [R_i, S_i]) + R_i )&lt;br&gt;    then residual GELU MLP&lt;br&gt;&lt;br&gt;2. &lt;b&gt;Ground&lt;/b&gt;  visual locations as queries, {C_i, R_i, S_i} as keys/values&lt;br&gt;    + learned 3D pos-enc on the 8³ grid&lt;br&gt;&lt;br&gt;3. Conv head  →  evidence map H_i  [B, 256, 8³]&lt;br&gt;&lt;br&gt;Shared weights: the only thing distinguishing slot 2 from slot 1 is its tokens. A per-slot module could cheat with a slot-specific shortcut." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontFamily=Helvetica;arcSize=8;verticalAlign=middle" parent="1" vertex="1">
                    <mxGeometry x="360" y="498" width="480" height="214" as="geometry"/>
                </mxCell>
                <mxCell id="28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="19" target="27" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="29" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="20" target="27" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="30" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="12" target="27" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="31" value="&lt;b&gt;Intersection&lt;/b&gt;&lt;br&gt;stack [H₁, H₂, H₃, σ(H₁)·σ(H₂)·σ(H₃)]&lt;br&gt;1×1 mix (256) → 3×3 refine&lt;br&gt;&lt;b&gt;F₃ ← F₃ + intersection&lt;/b&gt;  (condition, don’t replace)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontFamily=Helvetica;arcSize=8;verticalAlign=middle" parent="1" vertex="1">
                    <mxGeometry x="340" y="750" width="520" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="27" target="31" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="33" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;dashed=1;dashPattern=6 6;endArrow=open;endFill=0;strokeColor=#805AD5;" parent="1" source="31" target="12" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="34" value="The product term is the point. It is high only where every relation is satisfied at once, which is the definition of the target. Maps are sigmoided first or the product of unbounded activations has no usable gradient." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="340" y="864" width="520" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="35" value="&lt;b&gt;occupancy × (1 − max anchors)&lt;/b&gt;&lt;br&gt;decoder never sees the given twice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="1680" y="180" width="160" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="36" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="7" target="35" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="37" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;dashed=1;dashPattern=4 4;" parent="1" source="4" target="35" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="38" value="Decoder  (skips + occupancy + FiLM)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="880" y="180" width="760" height="560" as="geometry"/>
                </mxCell>
                <mxCell id="39" value="Per stage, coarse to fine: concat world xyz → trilinear upsample → concat encoder skip → concat max-pooled occupancy through a 1×1 → FiLM from cat(C₁,C₂,C₃) → refine ConvBlock." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="900" y="228" width="720" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="40" value="&lt;b&gt;16³ × 128&lt;/b&gt;&lt;br&gt;skip F₂ · occupancy max-pool · &lt;b&gt;FiLM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9D8FD;strokeColor=#6B46C1;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="980" y="300" width="520" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="41" value="&lt;b&gt;32³ × 64&lt;/b&gt;&lt;br&gt;skip F₁ · occupancy max-pool · &lt;b&gt;FiLM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9D8FD;strokeColor=#6B46C1;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="980" y="376" width="520" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="42" value="&lt;b&gt;64³ × 32&lt;/b&gt;&lt;br&gt;skip F₀ · occupancy max-pool · &lt;b&gt;no FiLM&lt;/b&gt; (finest is unmodulated, matching the reference)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9D8FD;strokeColor=#6B46C1;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="980" y="452" width="520" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="43" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="12" target="40" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="44" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;dashed=1;dashPattern=6 6;endArrow=open;endFill=0;strokeColor=#805AD5;" parent="1" source="11" target="40" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="40" target="41" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="46" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;dashed=1;dashPattern=6 6;endArrow=open;endFill=0;strokeColor=#805AD5;" parent="1" source="10" target="41" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="47" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="41" target="42" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="48" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;dashed=1;dashPattern=6 6;endArrow=open;endFill=0;strokeColor=#805AD5;" parent="1" source="9" target="42" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="49" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="35" target="40" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="50" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="35" target="41" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="51" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="35" target="42" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="52" value="FiLM context = cat(C)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="27" target="40" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="53" value="FiLM: y = (1 + γ(C)) · x + β(C), both projections zero-init so the decoder starts as the identity. Occupancy is max-pooled, not averaged: a thin structure (a torus at 64³) vanishes under averaging at quarter resolution." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="900" y="536" width="720" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="54" value="FiLM is applied at 16³ and 32³ only. Full-resolution attention would be 262,144 queries; that is why the decoder is FiLM and the only spatial attention sits at the bottleneck." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="900" y="604" width="720" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="55" value="&lt;b&gt;Head&lt;/b&gt;  1×1 conv, 32 → 1&lt;br&gt;weight = 0   bias = logit(0.0016)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FED7E2;strokeColor=#D53F8C;fontSize=11;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="980" y="770" width="520" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="56" value="&lt;b&gt;logits&lt;/b&gt;  [B, 1, 64, 64, 64]   →   sigmoid ≥ 0.5   →   predicted target mask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C6F6D5;strokeColor=#38A169;fontSize=12;fontFamily=Helvetica;fontStyle=1;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="980" y="850" width="520" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="57" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="42" target="55" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="58" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#4A5568;fontSize=10;fontColor=#2D3748;" parent="1" source="55" target="56" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="59" value="mask_geometry(mask_i) → 8 numbers, from the channel, never the manifest" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="960" width="820" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="60" value="centroid (x, y, z) in [−1, 1]&lt;br&gt;bounding-box extent as a fraction of each axis&lt;br&gt;cube root of occupied volume fraction (linear size, O(0.1) not O(0.001))&lt;br&gt;presence flag — empty predicted channel reads as “nothing”, not “a speck at the origin”&lt;br&gt;&lt;br&gt;masked_pool average-pools the mask onto the 8³ grid so a structure smaller than one cell still contributes. An empty channel falls back to globally pooled features instead of a NaN." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="1008" width="780" height="212" as="geometry"/>
                </mxCell>
                <mxCell id="61" value="What this architecture is built to prevent" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=13;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="880" y="960" width="760" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="62" value="• &lt;b&gt;Ignoring the prompt&lt;/b&gt; — occupancy is decoder-only, so “nearest non-anchor blob” is not sitting in the grounding queries.&lt;br&gt;• &lt;b&gt;Slot shortcuts&lt;/b&gt; — Evidence is shared; only the tokens differ across clauses.&lt;br&gt;• &lt;b&gt;Additive pooling of the sentence&lt;/b&gt; — clauses never collapse; intersection is an explicit product.&lt;br&gt;• &lt;b&gt;Repeating the given&lt;/b&gt; — anchors are subtracted from occupancy before the decoder sees it.&lt;br&gt;• &lt;b&gt;Oracle vs predicted interface drift&lt;/b&gt; — structure tokens are read off the mask channels they are handed, so a wrong Stage A mask describes that wrong mask." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=11;fontFamily=Helvetica;align=left;spacing=10;verticalAlign=top;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="900" y="1008" width="720" height="212" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>