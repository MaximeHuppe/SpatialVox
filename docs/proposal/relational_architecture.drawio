<mxfile host="65bd71144e">
    <diagram id="contract" name="1. Contract">
        <mxGraphModel dx="260" dy="817" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="Names stop at the anchor masks. The carver is name-free." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1A365D;fontFamily=Helvetica" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1100" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="s" value="After Stage A, the relational path receives soft detached masks and the pyramids those masks determine. No name embedding, no pair embedding, no slot embedding. An impossible prompt stays a small product. It is not divided by its own maximum." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontSize=13;fontFamily=Helvetica;align=left;spacing=12;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="68" width="1080" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="in1" value="&lt;b&gt;MRI&lt;/b&gt;&lt;br&gt;[B, 1, 128³]&lt;br&gt;z-scored over brain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontFamily=Helvetica;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="160" width="240" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="in2" value="&lt;b&gt;Three clauses&lt;/b&gt;&lt;br&gt;(direction, anchor name)&lt;br&gt;names used only here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontFamily=Helvetica;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="320" y="160" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="a" value="&lt;b&gt;Stage A · frozen&lt;/b&gt;&lt;br&gt;three names → logits&lt;br&gt;A = stopgrad(sigmoid)&lt;br&gt;features discarded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontFamily=Helvetica;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="280" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="m" value="&lt;b&gt;PositionalMapper3D&lt;/b&gt;&lt;br&gt;soft centroid, one pyramid F_i&lt;br&gt;where_raw = F₀·F₁·F₂&lt;br&gt;not divided by its max" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;fontFamily=Helvetica;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="340" y="280" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n" value="&lt;b&gt;Null head&lt;/b&gt;&lt;br&gt;MLP(where_mass, three masses)&lt;br&gt;no image, no names&lt;br&gt;invalid → empty mask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontFamily=Helvetica;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="710" y="280" width="250" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b" value="&lt;b&gt;B(I) · image only&lt;/b&gt;&lt;br&gt;generic boundary features&lt;br&gt;pretrained without class ids&lt;br&gt;no prompt, no coordinates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontFamily=Helvetica;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="430" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="c" value="&lt;b&gt;Carver&lt;/b&gt;&lt;br&gt;B(I), three soft masks, three fields,&lt;br&gt;where_raw, log(where_raw), where_mass&lt;br&gt;logits = residual, not residual + logit(where)&lt;br&gt;anchor voxels above 0.5 set to background" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontFamily=Helvetica;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="340" y="420" width="570" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="o1" value="&lt;b&gt;Mask&lt;/b&gt;&lt;br&gt;[B, 1, 128³]&lt;br&gt;including a structure&lt;br&gt;Stage A cannot name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C6F6D5;strokeColor=#38A169;fontSize=13;fontFamily=Helvetica;fontStyle=1;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="580" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="o2" value="&lt;b&gt;Centroid&lt;/b&gt;&lt;br&gt;heatmap, not the mask&lt;br&gt;kept when the mask is empty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C6F6D5;strokeColor=#38A169;fontSize=13;fontFamily=Helvetica;fontStyle=1;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="350" y="580" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="o3" value="&lt;b&gt;Valid&lt;/b&gt;&lt;br&gt;one logit&lt;br&gt;from field mass only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C6F6D5;strokeColor=#38A169;fontSize=13;fontFamily=Helvetica;fontStyle=1;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="640" y="580" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="tests" value="&lt;b&gt;Two tests.&lt;/b&gt; Prompt-only: drop B(I). If Dice holds, the mask is the spatial prior. Image replacement: keep anchors and fields, swap the MRI. The centroid should hold and boundary Dice should fall." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontSize=13;fontFamily=Helvetica;align=left;spacing=12;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="710" width="870" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="base" value="Entity-proposal selection is a baseline for “seen as a mask, never as a target.” It is not in this forward. A candidate list would require the output to be a structure Stage A can already draw." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontSize=13;fontFamily=Helvetica;align=left;spacing=12;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="800" width="870" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="ban" value="Not downstream of Stage A" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontStyle=1;fontSize=14;fontColor=#1A365D;arcSize=6;spacingTop=8" parent="1" vertex="1">
                    <mxGeometry x="960" y="160" width="680" height="700" as="geometry"/>
                </mxCell>
                <mxCell id="b1" value="anchor name, pair, and slot embeddings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontFamily=Helvetica;arcSize=6;dashed=1" parent="1" vertex="1">
                    <mxGeometry x="980" y="210" width="640" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="b2" value="direction vector, except inside the mapper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontFamily=Helvetica;arcSize=6;dashed=1" parent="1" vertex="1">
                    <mxGeometry x="980" y="266" width="640" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="b3" value="where_raw / max(where_raw)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontFamily=Helvetica;arcSize=6;dashed=1" parent="1" vertex="1">
                    <mxGeometry x="980" y="322" width="640" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="b4" value="logits = residual + logit(where) as the default&lt;br&gt;the α·logit form is an ablation, α one scalar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontFamily=Helvetica;arcSize=6;dashed=1" parent="1" vertex="1">
                    <mxGeometry x="980" y="378" width="640" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="b5" value="Stage A features, occupancy, candidate proposals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontFamily=Helvetica;arcSize=6;dashed=1" parent="1" vertex="1">
                    <mxGeometry x="980" y="448" width="640" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="b6" value="a coordinate grid in B or the carver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontFamily=Helvetica;arcSize=6;dashed=1" parent="1" vertex="1">
                    <mxGeometry x="980" y="504" width="640" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="b7" value="coverage loss on a valid prompt, except mass far outside a dilation of where_raw. Dice may follow the MRI past the pyramid." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=13;fontFamily=Helvetica;align=left;spacing=10;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="980" y="568" width="640" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="b8" value="The claim this supports: names obtain anchor masks. Target localization and carving do not receive a name." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontSize=13;fontFamily=Helvetica;align=left;spacing=10;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="980" y="670" width="640" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=1.5;endArrow=block;endFill=1" parent="1" source="in1" target="a" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="3 names" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica" parent="1" source="in2" target="a" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="soft masks + directions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica" parent="1" source="a" target="m" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="masses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica" parent="1" source="m" target="n" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=1.5;endArrow=block;endFill=1" parent="1" source="in1" target="b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" value="B(I)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica" parent="1" source="b" target="c" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" value="fields" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica" parent="1" source="m" target="c" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#38A169;strokeWidth=1.5;endArrow=block;endFill=1" parent="1" source="c" target="o1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#38A169;strokeWidth=1.5;endArrow=block;endFill=1" parent="1" source="c" target="o2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.5;endArrow=block;endFill=1" parent="1" source="n" target="o3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="mapper" name="2. Pyramid">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="PositionalMapper3D — classify, as a soft pyramid, on a soft mask" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1A365D;fontFamily=Helvetica" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1400" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="why" value="The field is the predicate that wrote the clause: one axis of the centroid offset dominates. The centroid is confidence-weighted on stopgrad(sigmoid). Mass below min_mass writes a zero field. There is no fade and no learned gain. The product is not divided by its maximum." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontSize=14;fontFamily=Helvetica;align=left;spacing=14;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="76" width="1600" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="&lt;b&gt;Superior / inferior&lt;/b&gt;&lt;br&gt;&lt;br&gt;d = p − c&lt;br&gt;&lt;br&gt;superior: d_z − max(|d_x|, |d_y|)&lt;br&gt;inferior: −d_z − max(|d_x|, |d_y|)&lt;br&gt;&lt;br&gt;Anterior and posterior are the same predicate on y." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontFamily=Helvetica;align=left;spacing=14;arcSize=8;verticalAlign=top" parent="1" vertex="1">
                    <mxGeometry x="40" y="190" width="500" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="&lt;b&gt;Lateral / medial&lt;/b&gt;&lt;br&gt;&lt;br&gt;x dominates, and the midline distance increases (lateral) or decreases (medial).&lt;br&gt;&lt;br&gt;Same rule as classify. center is volume_center_world." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;fontFamily=Helvetica;align=left;spacing=14;arcSize=8;verticalAlign=top" parent="1" vertex="1">
                    <mxGeometry x="580" y="190" width="500" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="c3" value="&lt;b&gt;Product&lt;/b&gt;&lt;br&gt;&lt;br&gt;F = sigmoid(margin / τ)&lt;br&gt;τ = 2 mm&lt;br&gt;&lt;br&gt;where_raw = F₀·F₁·F₂&lt;br&gt;where_mass = mean(where_raw)&lt;br&gt;&lt;br&gt;A tiny peak stays tiny." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=14;fontFamily=Helvetica;align=left;spacing=14;arcSize=8;verticalAlign=top" parent="1" vertex="1">
                    <mxGeometry x="1120" y="190" width="520" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="gate" value="&lt;b&gt;Gate.&lt;/b&gt; On the training manifests, ground-truth anchors used only as a check: the fraction of target centroids with where_raw &gt; 0.5. The threshold is absolute. A flip must move the centroid off that region. The carver waits on this fraction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontSize=14;fontFamily=Helvetica;align=left;spacing=14;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="450" width="1600" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="body" value="&lt;b&gt;The pyramid is about the centroid.&lt;/b&gt; Voxels of the target on the near side can sit outside it. where_raw is a channel into the carver. It does not multiply the mask, and logit(where_raw) is not added to the logits unless the scalar-α ablation is on." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontSize=14;fontFamily=Helvetica;align=left;spacing=14;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="570" width="1600" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="train" name="3. Losses and tests">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="A changed prompt is retargeted, emptied, or dropped. It is not assumed empty." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1A365D;fontFamily=Helvetica" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1500" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="h1" value="&lt;b&gt;Names one structure&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A365D;fontColor=#FFFFFF;strokeColor=#1A365D;fontSize=14;fontFamily=Helvetica;fontStyle=1;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="400" y="80" width="400" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="h2" value="&lt;b&gt;Names none&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A365D;fontColor=#FFFFFF;strokeColor=#1A365D;fontSize=14;fontFamily=Helvetica;fontStyle=1;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="820" y="80" width="380" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="h3" value="&lt;b&gt;Names two&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A365D;fontColor=#FFFFFF;strokeColor=#1A365D;fontSize=14;fontFamily=Helvetica;fontStyle=1;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="1220" y="80" width="400" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="r1" value="&lt;b&gt;Mask&lt;/b&gt; Dice + BCE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=13;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="40" y="140" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="r1a" value="that structure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C6F6D5;strokeColor=#38A169;fontSize=13;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="400" y="140" width="400" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="r1b" value="empty volume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="820" y="140" width="380" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="r1c" value="dropped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=13;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="1220" y="140" width="400" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="r2" value="&lt;b&gt;Null head&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=13;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="40" y="210" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="r2a" value="valid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C6F6D5;strokeColor=#38A169;fontSize=13;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="400" y="210" width="400" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="r2b" value="invalid, because where_mass is tiny" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="820" y="210" width="380" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="r2c" value="dropped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=13;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="1220" y="210" width="400" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="r3" value="&lt;b&gt;L_far&lt;/b&gt; mass outside the dilated field" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=13;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="40" y="280" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="r3a" value="applied. Dice may still cross the pyramid." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="400" y="280" width="400" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="r3b" value="not added. The empty mask is the penalty." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="820" y="280" width="380" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="r3c" value="dropped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontSize=13;fontFamily=Helvetica;arcSize=6" parent="1" vertex="1">
                    <mxGeometry x="1220" y="280" width="400" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="t1" value="&lt;b&gt;Prompt-only carver&lt;/b&gt;&lt;br&gt;&lt;br&gt;Remove B(I). Keep anchors and where_raw.&lt;br&gt;If Dice approaches the full model, the mask is a spatial prior and the MRI is unused." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontSize=14;fontFamily=Helvetica;align=left;spacing=14;arcSize=8;verticalAlign=top" parent="1" vertex="1">
                    <mxGeometry x="40" y="380" width="780" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="t2" value="&lt;b&gt;Image replacement&lt;/b&gt;&lt;br&gt;&lt;br&gt;Keep this subject’s anchors and fields. Feed B a different MRI, or a corrupted one.&lt;br&gt;Centroid should hold. Boundary Dice should fall." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontSize=14;fontFamily=Helvetica;align=left;spacing=14;arcSize=8;verticalAlign=top" parent="1" vertex="1">
                    <mxGeometry x="860" y="380" width="760" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="split" value="&lt;b&gt;Checkpointing.&lt;/b&gt; best.pt is chosen on the eight supervised targets. The four (caudate, putamen) are scored and do not select the checkpoint. Today validation Dice is those four, so the split has to move before a number is quoted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontSize=14;fontFamily=Helvetica;align=left;spacing=14;arcSize=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="540" width="1580" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>